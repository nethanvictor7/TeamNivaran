# CDEP AlloyDB connection template.
# Copy this file to a secret-managed environment source. Never commit the
# populated password.
DATABASE_HOST=34.16.91.2
DATABASE_PORT=5432
DATABASE_USER=cdep_admin
DATABASE_PASSWORD=replace-with-alloydb-password
DATABASE_SSL_MODE=require

# Each application keeps its own database while sharing the connection account.
IDENTITY_DB_NAME=cdep_identity
CASE_DB_NAME=cdep_case
INTEGRATION_DB_NAME=cdep_integration
EVIDENCE_DB_NAME=cdep_evidence
WORKFLOW_DB_NAME=cdep_workflow
AI_DB_NAME=cdep_ai
LEDGER_DB_NAME=cdep_ledger

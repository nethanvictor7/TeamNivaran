# Local infrastructure
POSTGRES_SUPERUSER=cdep_admin
POSTGRES_SUPERUSER_PASSWORD=replace-with-strong-local-password

# Shared application database connection. Compose builds each service's
# DATABASE_URL from these values plus that service's *_DB_NAME below.
# Keep postgres/disable for the local profile. Use the AlloyDB values from
# .env.alloydb.example for GKE or other managed deployments.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=cdep_admin
DATABASE_PASSWORD=replace-with-strong-database-password
DATABASE_SSL_MODE=disable

IDENTITY_DB_USER=cdep_identity_app
IDENTITY_DB_PASSWORD=replace-with-strong-identity-password
IDENTITY_DB_NAME=cdep_identity
CASE_DB_USER=cdep_case_app
CASE_DB_PASSWORD=replace-with-strong-case-password
CASE_DB_NAME=cdep_case
INTEGRATION_DB_USER=cdep_integration_app
INTEGRATION_DB_PASSWORD=replace-with-strong-integration-password
INTEGRATION_DB_NAME=cdep_integration
EVIDENCE_DB_USER=cdep_evidence_app
EVIDENCE_DB_PASSWORD=replace-with-strong-evidence-password
EVIDENCE_DB_NAME=cdep_evidence
WORKFLOW_DB_USER=cdep_workflow_app
WORKFLOW_DB_PASSWORD=replace-with-strong-workflow-password
WORKFLOW_DB_NAME=cdep_workflow
AI_DB_USER=cdep_ai_app
AI_DB_PASSWORD=replace-with-a-strong-ai-database-password
AI_DB_NAME=cdep_ai
AI_ADAPTER_MODE=MOCK
AI_ASSESSMENTS_ENABLED=true
AI_WORKER_ENABLED=true
AI_OUTPUT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
LEDGER_DB_USER=cdep_ledger_app
LEDGER_DB_PASSWORD=replace-with-a-strong-ledger-database-password
LEDGER_DB_NAME=cdep_ledger
LEDGER_PROVIDER=FABRIC
LEDGER_WORKER_ENABLED=true
LEDGER_WORKER_POLL_INTERVAL_MS=500
LEDGER_WORKER_LEASE_SECONDS=60
AUDIT_DB_USER=cdep_audit_app
AUDIT_DB_PASSWORD=replace-with-a-strong-audit-database-password
AUDIT_DB_NAME=cdep_audit

# API Gateway
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_URL=http://identity-access-service:3001
JWT_ISSUER=cdep-identity-access-service
JWT_AUDIENCE=cdep-api
JWT_JWKS_URL=http://identity-access-service:3001/api/v1/auth/jwks
CASE_SERVICE_URL=http://case-service:3002
INTEGRATION_SERVICE_URL=http://integration-ingestion-service:3003
EVIDENCE_SERVICE_URL=http://evidence-service:3004
WORKFLOW_SERVICE_URL=http://validation-workflow-service:3005
AI_ASSESSMENT_SERVICE_URL=http://ai-assessment-service:3006
LEDGER_SERVICE_URL=http://ledger-service:3007
AUDIT_SERVICE_URL=http://audit-query-service:3008

# Identity Access Service
IDENTITY_SERVICE_PORT=3001
DATABASE_URL=postgresql://cdep_admin:change-me-database-password@postgres:5432/cdep_identity?sslmode=disable
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_KEY_ID=cdep-local-2026-01
JWT_ALLOW_EPHEMERAL_KEYS=true
REFRESH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@cdep.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-admin-password
BOOTSTRAP_ORGANIZATION_NAME=CDEP Local Bank
BOOTSTRAP_REVIEWER_EMAIL=reviewer@cdep.local
BOOTSTRAP_APPROVER_EMAIL=approver@cdep.local
BOOTSTRAP_AUDITOR_EMAIL=auditor@cdep.local
BOOTSTRAP_OUTSIDER_EMAIL=outsider@cdep.local
GARAGE_RPC_SECRET=replace-with-64-character-hex-value
GARAGE_ADMIN_TOKEN=replace-with-strong-local-admin-token
OBJECT_STORAGE_ENDPOINT=http://garage:3900
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:3900
OBJECT_STORAGE_REGION=cdep-local
OBJECT_STORAGE_QUARANTINE_BUCKET=cdep-evidence-quarantine
OBJECT_STORAGE_EVIDENCE_BUCKET=cdep-evidence-canonical
OBJECT_STORAGE_ACCESS_KEY=GKreplace-with-32-hex-characters
OBJECT_STORAGE_SECRET_KEY=replace-with-64-hex-characters
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=60

# Kafka: use kafka:9092 inside Docker and localhost:29092 from the host.
KAFKA_BROKERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
CASE_SERVICE_PORT=3002
CASE_DATABASE_URL=postgresql://cdep_admin:change-me-database-password@postgres:5432/cdep_case?sslmode=disable
INTEGRATION_DATABASE_URL=postgresql://cdep_admin:change-me-database-password@postgres:5432/cdep_integration?sslmode=disable
CONNECTOR_SECRET_PROVIDER=local
CONNECTOR_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-byte-base64url-key
CONNECTOR_CREDENTIAL_KEY_ID=cdep-local-integration-01
INTERNAL_SERVICE_TOKEN=replace-with-a-strong-shared-internal-service-token
WEBHOOK_MAX_BODY_BYTES=1048576
SQL_POLL_DEFAULT_BATCH_SIZE=100
SQL_POLL_MAX_BATCH_SIZE=1000
SQL_POLL_MAX_INITIAL_LOOKBACK_MINUTES=10080
SQL_POLL_LEASE_SECONDS=60
SQL_POLL_FAILURE_PAUSE_THRESHOLD=5
EVIDENCE_SERVICE_PORT=3004
EVIDENCE_DATABASE_URL=postgresql://cdep_admin:change-me-database-password@postgres:5432/cdep_evidence?sslmode=disable
WORKFLOW_SERVICE_PORT=3005
WORKFLOW_DATABASE_URL=postgresql://cdep_admin:change-me-database-password@postgres:5432/cdep_workflow?sslmode=disable
WORKFLOW_CONSUMER_GROUP=cdep-validation-workflow-v1
WORKFLOW_TASK_DEFAULT_DUE_HOURS=24
WORKFLOW_DECISION_DEFAULT_DUE_HOURS=24
WORKFLOW_TIMER_POLL_INTERVAL_MS=1000
WORKFLOW_TIMER_LEASE_SECONDS=60
WORKFLOW_REVALIDATION_DEBOUNCE_MS=1000
WORKFLOW_CASE_SYNC_MAX_ATTEMPTS=5
WORKFLOW_CASE_SYNC_RETRY_BASE_MS=1000
LEDGER_SERVICE_PORT=3007
LEDGER_DATABASE_URL=postgresql://cdep_admin:change-me-database-password@postgres:5432/cdep_ledger?sslmode=disable
FABRIC_CHANNEL_NAME=cdep-proof-channel
FABRIC_CHAINCODE_NAME=cdep-proof-registry
FABRIC_MSP_ID=CDEPMSP
FABRIC_GATEWAY_ENDPOINT=peer0.cdep.example.com:7051
FABRIC_GATEWAY_SERVER_NAME=peer0.cdep.example.com
FABRIC_GATEWAY_TLS_CERT_PATH=/fabric/crypto/peerOrganizations/cdep.example.com/peers/peer0.cdep.example.com/tls/ca.crt
FABRIC_IDENTITY_CERT_PATH=/fabric/crypto/peerOrganizations/cdep.example.com/users/Admin@cdep.example.com/msp/signcerts/Admin@cdep.example.com-cert.pem
FABRIC_IDENTITY_KEY_PATH=/fabric/crypto/peerOrganizations/cdep.example.com/users/Admin@cdep.example.com/msp/keystore/priv_sk
FABRIC_COMMIT_TIMEOUT_MS=30000
FABRIC_RETRY_MAX_ATTEMPTS=5
AUDIT_SERVICE_PORT=3008
AUDIT_DATABASE_URL=postgresql://cdep_admin:change-me-database-password@postgres:5432/cdep_audit?sslmode=disable
CURSOR_SIGNING_SECRET=replace-with-at-least-32-random-characters
KAFKA_GROUP_ID=cdep-audit-authority-v1
OBJECT_STORAGE_AUDIT_BUCKET=cdep-audit-artifacts
ARTIFACT_RETENTION_HOURS=168
DOWNLOAD_GRANT_SECONDS=300
JOB_POLL_INTERVAL_MS=500
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=30000
EVIDENCE_MAX_UPLOAD_BYTES=10485760
EVIDENCE_ALLOWED_MEDIA_TYPES=application/pdf,image/png,image/jpeg,text/plain
EVIDENCE_PROCESSING_MAX_ATTEMPTS=3
EVIDENCE_PROCESSING_LEASE_SECONDS=60
EVIDENCE_ORPHAN_SAFETY_PERIOD_HOURS=24
DEMO_SOURCE_READER=demo_reader
DEMO_SOURCE_PASSWORD=replace-with-demo-reader-password

# Web portal
VITE_API_BASE_URL=/api
VITE_DEMO_MODE=true
